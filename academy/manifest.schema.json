{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://elsaworkflows.io/schemas/academy-lesson-plan.json",
  "title": "Academy import manifest (elsa-hub#40)",
  "type": "object",
  "required": ["courses"],
  "additionalProperties": true,
  "properties": {
    "issue": { "type": "string" },
    "schema": { "type": "string" },
    "generated": { "type": "string" },
    "elsa_version": { "type": "string" },
    "source_root": { "type": ["string", "null"] },
    "source_root_note": { "type": "string" },
    "link_convention": { "type": "string" },
    "import_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "excluded_asset_sha256_prefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 }
    },
    "kit_release": {
      "type": "object",
      "required": ["tag", "asset", "sha256", "bytes"],
      "additionalProperties": true,
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string" },
        "asset": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "storage_path": { "type": "string" },
        "owner_course": { "type": "string" }
      }
    },
    "module_rewrites": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/rewrite" }
      }
    },
    "web_source_rewrites": {
      "type": "array",
      "items": { "$ref": "#/definitions/rewrite" }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/course" }
    }
  },
  "definitions": {
    "rewrite": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": true,
      "properties": {
        "course": { "type": "string" },
        "source": { "type": "string" },
        "file": { "type": "string" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string" }
      }
    },
    "course": {
      "type": "object",
      "required": ["slug", "title", "lessons"],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": ["string", "null"] },
        "sort_order": { "type": "integer" },
        "is_published": { "type": "boolean" },
        "price_cents": { "type": ["integer", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] },
        "product_code": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
        "stripe_price_id": { "type": ["string", "null"] },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/lesson" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/definitions/asset" }
        },
        "extra_assets": {
          "description": "Additional academy-kits uploads for this course (S1 to S4 security add-on files, and any later local files). Same shape as assets; file may be any local path.",
          "type": "array",
          "items": { "$ref": "#/definitions/asset" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["slug"],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": ["string", "null"] },
        "source_md": { "type": "string" },
        "body_md_file": { "type": "string" },
        "sort_order": { "type": "integer" },
        "is_preview": { "type": "boolean" },
        "estimated_minutes": { "type": ["integer", "null"], "minimum": 1 },
        "preview_reason": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": true,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "storage_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "lesson_slug": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "file": {
          "description": "Local path to the file to upload. Absolute, or relative to --source-root / --assets-dir. Alias of source.",
          "type": "string"
        },
        "file_name": { "type": "string" },
        "skip": { "type": "boolean" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "extras": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 0 },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
